{
  // Modules sans JSX de src/lib/, compilés en JavaScript pour les tests
  // unitaires (`npm run test:unit`, fichiers test/unit/*.test.mjs).
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "rootDir": "src/lib",
    "outDir": ".unit-test"
  },
  "include": ["src/lib/**/*.ts"]
}
